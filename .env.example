# Copy this file to .env.local for local development and add the same keys
# to your hosting provider (Vercel > Project > Settings > Environment Variables).
# Never commit real values.

# --- Site -------------------------------------------------------------------
# Your production domain, no trailing slash. Used for canonical URLs, sitemap,
# Open Graph and structured data.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# --- Analytics (optional, all public IDs) -----------------------------------
# Google Tag Manager container ID. Recommended: configure GA4 inside GTM.
NEXT_PUBLIC_GTM_ID=
# GA4 Measurement ID. Only used when NEXT_PUBLIC_GTM_ID is empty, so events
# are never sent twice.
NEXT_PUBLIC_GA_ID=
# Google Search Console HTML-tag verification token (content="..." value only).
NEXT_PUBLIC_GSC_VERIFICATION=

# --- Booking (Cal.com) ---------------------------------------------------------
# Your Cal.com event path, e.g. "your-handle/discovery-call".
NEXT_PUBLIC_CAL_LINK=
# Only change if you self-host Cal.com or use Cal.com EU (https://app.cal.eu).
NEXT_PUBLIC_CAL_ORIGIN=https://app.cal.com

# --- Enquiry delivery (server-only; configure at least one) --------------------
# Option A: email via Resend (https://resend.com). The FROM address must use a
# domain you have verified in Resend.
RESEND_API_KEY=
ENQUIRY_FROM_EMAIL="Sendworthy Website <website@example.com>"
ENQUIRY_TO_EMAIL=hello@example.com
# Option B: POST each enquiry as JSON to a webhook (Slack workflow, Zapier,
# Make, n8n, Google Apps Script, your CRM...).
ENQUIRY_WEBHOOK_URL=

# --- Spam protection (optional, Cloudflare Turnstile) -------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
